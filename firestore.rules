rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All authenticated users (Super Admin, Shop Owners, Staff) can read and write
    // Public POS/Domain resolution can read shop configurations
    match /shops/{shopId} {
      allow read: if true;
      allow write: if request.auth != null;
      
      match /{subcollection}/{document=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    match /platform/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
